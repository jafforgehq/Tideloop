{
  "name": "tideloop",
  "productName": "Tideloop",
  "version": "0.0.4",
  "description": "A week planner for macOS with a tide chart that shows how full each day is",
  "license": "MIT",
  "homepage": "https://jafforgehq.github.io/tideloop-app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jafforgehq/Tideloop.git"
  },
  "bugs": {
    "url": "https://github.com/jafforgehq/Tideloop/issues"
  },
  "author": "Feda Hadziselimovic",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:page": "vite build --config vite.page.config.mts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "electron-vite build && playwright test",
    "dist": "electron-vite build && electron-builder --mac --arm64 --x64 --publish never",
    "dist:unsigned": "electron-vite build && electron-builder --mac --arm64 -c.mac.identity=null -c.mac.notarize=false -c.dmg.sign=false --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "electron-updater": "^6.8.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/familjen-grotesk": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
